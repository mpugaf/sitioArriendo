# ─── Cloudinary ────────────────────────────────────────────────────────────────
# Nombre de tu cloud en Cloudinary (visible en el dashboard).
# El prefijo PUBLIC_ lo expone en el cliente para construir URLs de galería.
PUBLIC_CLOUDINARY_CLOUD_NAME=dmbkdrlcj

# ─── Gmail SMTP ────────────────────────────────────────────────────────────────
# Correo Gmail desde el que se enviarán los mensajes.
GMAIL_USER=marco.puga@gmail.com

# Contraseña de aplicación (NO la contraseña de Gmail).
# Cómo obtenerla: activar 2FA → myaccount.google.com/apppasswords → crear app.
GMAIL_APP_PASSWORD=mhdj lrga tfwt soqy

# ─── Destinatario propietario ──────────────────────────────────────────────────
# Recibirá una copia oculta (BCC) de cada formulario enviado.
OWNER_EMAIL=marco.puga@gmail.com
