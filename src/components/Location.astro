---
import { property } from '../data/property';
---

<section id="ubicacion" class="py-20 px-4 sm:px-6 bg-white">
  <div class="max-w-5xl mx-auto">
    <h2 class="font-serif text-4xl text-warm-900 mb-3">Ubicación</h2>
    <p class="text-warm-500 mb-8">{property.address}</p>

    <!--
      TODO: Reemplaza el src del iframe con el embed de Google Maps de tu propiedad.

      Cómo obtenerlo:
      1. Abre maps.google.com y busca la dirección exacta.
      2. Haz clic en "Compartir" → pestaña "Insertar un mapa".
      3. Selecciona tamaño personalizado y copia el código <iframe>.
      4. Pega solo el valor del atributo src aquí abajo.
    -->
    <div class="w-full h-80 sm:h-96 rounded-xl overflow-hidden shadow-sm border border-warm-100">
      <iframe
        src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d1488!2d-70.6370342!3d-33.4442382!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x9662c577ee701781%3A0xac725dca877b55bb!2sGral.+Jofr%C3%A9+67%2C+8330104+Santiago%2C+Regi%C3%B3n+Metropolitana!5e0!3m2!1ses!2scl!4v1746182400000!5m2!1ses!2scl"
        width="100%"
        height="100%"
        style="border:0;"
        allowfullscreen
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade"
        title="Ubicación: Gral. Jofré 67, Santiago"
      ></iframe>
    </div>
  </div>
</section>
