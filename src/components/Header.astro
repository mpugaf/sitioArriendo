---
---

<header class="sticky top-0 z-40 bg-warm-50/95 backdrop-blur-sm border-b border-warm-200">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 h-16 flex items-center justify-between">
    <span class="font-serif text-lg text-warm-900 truncate mr-4">
      Departamento único en el sector
    </span>

    <button
      id="open-modal-btn"
      class="shrink-0 px-5 py-2 bg-accent hover:bg-accent-dark text-white text-sm font-medium rounded-full transition-colors focus:outline-none focus:ring-2 focus:ring-accent focus:ring-offset-2"
      aria-haspopup="dialog"
    >
      Contactar
    </button>
  </div>
</header>

<script>
  document.getElementById('open-modal-btn')?.addEventListener('click', () => {
    document.dispatchEvent(new CustomEvent('open-contact-modal'));
  });
</script>
