---
import { property } from '../data/property';
---

<footer class="bg-warm-900 text-warm-300 py-12 px-4 sm:px-6">
  <div class="max-w-5xl mx-auto">
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-6">
      <div>
        <h3 class="font-serif text-xl text-white mb-1">{property.title}</h3>
        <p class="text-sm text-warm-400">{property.address}</p>
      </div>

      <button
        id="footer-open-modal-btn"
        class="self-start sm:self-auto px-6 py-3 bg-accent hover:bg-accent-light text-white text-sm font-medium rounded-full transition-colors focus:outline-none focus:ring-2 focus:ring-accent focus:ring-offset-2 focus:ring-offset-warm-900"
        aria-haspopup="dialog"
      >
        Solicitar información
      </button>
    </div>

    <div class="mt-10 pt-6 border-t border-warm-800 text-xs text-warm-500">
      <p>© {new Date().getFullYear()} {property.title}. Todos los derechos reservados.</p>
    </div>
  </div>
</footer>

<script>
  document.getElementById('footer-open-modal-btn')?.addEventListener('click', () => {
    document.dispatchEvent(new CustomEvent('open-contact-modal'));
  });
</script>
