---
import { property } from '../data/property';
---

<footer class="bg-warm-900 text-warm-300 py-14 px-4 sm:px-6">
  <div class="max-w-5xl mx-auto">
    <div class="flex flex-col sm:flex-row sm:items-start sm:justify-between gap-8">
      <div class="max-w-sm">
        <h3 class="font-serif text-2xl text-white mb-2">Lo encontraste</h3>
        <p class="text-sm text-warm-400 leading-relaxed">
          Está disponible hoy. Departamentos así no se vuelven a ver. Si no lo tomas tú, alguien más lo hará.
        </p>
      </div>

      <div class="flex flex-col gap-2 sm:text-right">
        <p class="text-xs text-warm-500 uppercase tracking-widest">Ubicación</p>
        <p class="text-warm-300 text-sm">{property.address}</p>
        <button
          id="footer-open-modal-btn"
          class="mt-3 self-start sm:self-end px-6 py-3 bg-accent hover:bg-accent-light text-white text-sm font-medium rounded-full transition-colors focus:outline-none focus:ring-2 focus:ring-accent focus:ring-offset-2 focus:ring-offset-warm-900"
          aria-haspopup="dialog"
        >
          Me interesa
        </button>
      </div>
    </div>

    <div class="mt-10 pt-6 border-t border-warm-800 text-xs text-warm-500 flex flex-col sm:flex-row sm:justify-between gap-2">
      <p>© {new Date().getFullYear()} Lo Encontraste — Arriendos directos. Sin vueltas.</p>
      <p>Santiago, Chile</p>
    </div>
  </div>
</footer>

<script>
  document.getElementById('footer-open-modal-btn')?.addEventListener('click', () => {
    document.dispatchEvent(new CustomEvent('open-contact-modal'));
  });
</script>
