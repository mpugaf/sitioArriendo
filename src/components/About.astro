---
import { property, images } from '../data/property';

const galleryTotal = images.filter(img => !img.isHero).length;
const formattedRent = `$${property.monthlyRent.toLocaleString('es-CL')}`;

const stats = [
  { label: 'Dormitorios',       value: String(property.bedrooms) },
  { label: 'Baños',             value: String(property.bathrooms) },
  { label: 'Superficie',        value: `${property.sqm} m²` },
  { label: 'Terraza',           value: '35 m²' },
  { label: 'Bodega',            value: property.storage ? 'Incluida' : 'No incluida' },
  { label: 'Ubicación',         value: property.location },
  { label: 'Metro',             value: 'Parque Bustamante (L5)' },
];
---

<section id="sobre-la-propiedad" class="py-20 px-4 sm:px-6 bg-white">
  <div class="max-w-5xl mx-auto">
    <h2 class="font-serif text-4xl text-warm-900 mb-6">Sobre la propiedad</h2>

    <p class="text-warm-600 text-lg leading-relaxed mb-6 max-w-3xl">
      {property.description}
    </p>

    <p class="border-l-2 border-accent pl-4 text-sm font-medium text-warm-700 mb-14 max-w-2xl leading-relaxed">
      No hay otro igual. Semejante extensión de terraza, en esta ubicación, es una combinación
      que difícilmente vuelva a repetirse.
    </p>

    <div class="grid grid-cols-2 sm:grid-cols-3 gap-4">
      {stats.map((stat) => (
        <div class="bg-warm-50 border border-warm-100 rounded-xl p-6">
          <div class="text-xs font-semibold text-warm-500 uppercase tracking-widest mb-2">
            {stat.label}
          </div>
          <div class="font-serif text-2xl text-warm-900 leading-tight">
            {stat.value}
          </div>
        </div>
      ))}
    </div>

    <div class="mt-4 bg-warm-50 border border-warm-100 rounded-xl p-6">
      <div class="text-xs font-semibold text-warm-500 uppercase tracking-widest mb-3">
        Arriendo mensual
      </div>

      <div id="price-locked-state">
        <div class="font-serif text-3xl text-warm-300 mb-4 tracking-widest select-none">
          $ ···.···
        </div>
        <div class="flex items-center gap-3 mb-2">
          <div class="flex-1 bg-warm-200 rounded-full h-1.5">
            <div
              id="price-progress-bar"
              class="bg-accent h-1.5 rounded-full transition-all duration-500"
              style="width: 0%"
            ></div>
          </div>
          <span id="price-progress-text" class="text-xs text-warm-400 whitespace-nowrap shrink-0">
            0 / {galleryTotal} fotos
          </span>
        </div>
        <p class="text-xs text-warm-500">Navega por la galería para conocer el precio</p>
      </div>

      <div id="price-unlocked-state" class="hidden">
        <div class="font-serif text-3xl text-warm-900">
          {formattedRent}
          <span class="font-sans text-base font-normal text-warm-500 ml-1">/ mes</span>
        </div>
        <ul class="mt-3 space-y-1 text-sm text-warm-600">
          <li>Dos ambientes bien diferenciados: el dormitorio no comparte espacio con el living</li>
          <li>Terraza de 35 m² con vista al Cerro San Cristóbal, más extensa que el propio interior</li>
          <li>Bodega incluida</li>
        </ul>
        <p class="mt-4 text-xs font-semibold uppercase tracking-widest text-accent">
          Disponible ahora — no habrá otro igual
        </p>
      </div>
    </div>
  </div>
</section>

<script>
  const progressBar = document.getElementById('price-progress-bar') as HTMLElement | null;
  const progressText = document.getElementById('price-progress-text');
  const lockedState = document.getElementById('price-locked-state');
  const unlockedState = document.getElementById('price-unlocked-state');

  window.addEventListener('gallery-progress', (e) => {
    const { count, total } = (e as CustomEvent<{ count: number; total: number }>).detail;
    const pct = Math.round((count / total) * 100);
    if (progressBar) progressBar.style.width = `${pct}%`;
    if (progressText) progressText.textContent = `${count} / ${total} fotos`;
  });

  window.addEventListener('price-unlocked', () => {
    lockedState?.classList.add('hidden');
    unlockedState?.classList.remove('hidden');
  });
</script>
